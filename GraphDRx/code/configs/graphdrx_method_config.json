  "family_hierarchy_specificity": {
    "basis": "parent DISEASE child-degree with continuous specificity and distinct-disease support multiplicity; no disease-name or answer rules",
    "score": "1/log2(2+family_child_degree)",
    "support_base": 0.4,
    "max_required_supports": 4,
    "minimum_specificity": 0.2,
    "applies_to": [
      "family_label_edge",
      "sibling_gene_action",
      "family_clinical_prior"
    ],
    "acceptance": "family-only evidence is evaluated within one ontology-parent cluster; distinct sibling diseases count once, qualified semantic-prior provenance adds at most one corroboration unit per cluster, and only the strongest sufficiently supported parent cluster is retained",
    "clinical_support_relations": {
      "primary": [
        "indication",
        "off_label_use"
      ],
      "tested_indication_min_phase": 1.0,
      "secondary_context_only": [
        "studied_for_treatment_of"
      ],
      "excluded": [
        "studied_for_marker_mechanism_of"
      ]
    }
  },
