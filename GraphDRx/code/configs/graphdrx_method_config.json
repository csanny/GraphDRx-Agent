    "tested_indication_phase_policy": "retain edge phases 0, 0.5, 1, 2, 3, and 4 (and missing as weakest); apply edge-level phase-aware weights; require phase >=1 only when tested_indication is used as primary family-clinical support",
    "contraindication_only_seed_allowed": false
