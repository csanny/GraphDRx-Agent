{
  "method_name": "GraphDRx retrieval pipeline - deterministic anchors with structural single-indirect reserve",
  "config_id": "graphdrx_final_structural_reserve_v1",
  "random_seed": 42,
  "design_constraints": {
    "area_adaptation_basis": "independent nonbenchmark KG topology from a frozen 696-disease core design sample; no gold labels, model outputs, or benchmark outcomes",
