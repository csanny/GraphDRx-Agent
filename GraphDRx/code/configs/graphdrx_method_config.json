    },
    "prior_existing_graph_policy": {
      "skip_existing_graph_drugs": true,
      "interpretation": "Prior drugs already supported by T/B/D retain their existing graph path and receive semantic prior provenance without claiming explicit C_v re-verification. Prior-only drugs must pass target-disease graph verification before admission."
    }
